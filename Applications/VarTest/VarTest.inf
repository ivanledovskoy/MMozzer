## @file
#  VarTest - NS-world UEFI application that talks to the StandaloneMM variable
#  handler via RAW MM_COMMUNICATE (EFI_MM_COMMUNICATION2_PROTOCOL), building the
#  comm buffer by hand so the message size (MessageLength) is fully controlled.
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = VarTest
  FILE_GUID                      = 3F8E1C20-7A4B-4D9E-B6C1-2A5D8E0F1234
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = UefiMain

[Sources]
  VarTest.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEfiMmCommunication2ProtocolGuid
  gEfiSmmVariableProtocolGuid
